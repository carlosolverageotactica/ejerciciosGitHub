# PostgreSQL + PostGIS Environment Configuration
# Copy this file to .env and adjust values as needed

# PostgreSQL
POSTGRES_DB=geodb
POSTGRES_USER=geouser
# IMPORTANT: Replace with a strong, random password in production (e.g., openssl rand -base64 32)
POSTGRES_PASSWORD=CHANGE_ME_use_a_strong_password
POSTGRES_PORT=5432

# pgAdmin
PGADMIN_EMAIL=admin@example.com
# IMPORTANT: Replace with a strong, random password in production
PGADMIN_PASSWORD=CHANGE_ME_use_a_strong_password
PGADMIN_PORT=5050
